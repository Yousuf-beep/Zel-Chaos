ANTHROPIC_API_KEY=
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
CLAUDE_FAST_MODEL=claude-haiku-5-5
CLAUDE_MAIN_MODEL=claude-sonnet-5-5
# Groq Cloud runs every LLM step (extraction, result card, guardrail check, companion chat). Real LLM whenever this key is set.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# llama-3.3-70b-versatile is no longer offered; gpt-oss-120b is the closest available model.
GROQ_MODEL=openai/gpt-oss-120b
# false = use each real service whose key is present; true = force every service to its mock.
MOCK_MODE=true
DEMO_MODE=false
MAX_FOLLOWUPS=4
SESSION_TTL_MIN=30
ALLOWED_ORIGINS=http://localhost:3000
# Optional: full path to ffmpeg if it is not on PATH. Without ffmpeg, audio still works (WAV only, no transcoding).
FFMPEG_PATH=
# Optional: temp folder for audio conversion (defaults to the system temp folder).
AUDIO_TMP_DIR=
# mp3 (smaller, needs ffmpeg) or wav
TTS_OUTPUT_FORMAT=mp3
TTS_PACE=1.0
# Leave empty to call the backend through the Next.js /api rewrite (one origin, easiest for phone + HTTPS tunnel).
NEXT_PUBLIC_API_BASE=
BACKEND_URL=http://localhost:8000
# SQLite fallback file when DATABASE_URL is empty. Defaults to backend/data/nola.db.
AUTH_DB_PATH=
AUTH_TTL_DAYS=30
# Supabase Postgres (backend only): accounts, cycle data, companion chat history and notes.
# Empty = local SQLite at AUTH_DB_PATH plus in-memory chat history (tests / offline dev).
# URL-encode the password if it contains @ : / ? #. On IPv4-only hosts use the Session pooler string from Supabase -> Connect.
DATABASE_URL=
DB_POOL_MAX=10
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
HISTORY_TTL_DAYS=90
# AES-256-GCM key that encrypts chat text, titles, Nola's notes, reports and sign-up answers before they reach the database.
# Required whenever DATABASE_URL is set (the backend refuses to start without it). Back it up: lose it and saved chats are unreadable.
# Generate: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
DATA_ENCRYPTION_KEY=
